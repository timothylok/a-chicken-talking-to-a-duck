{
  "rules": [
    {
      "id": "umbrella-alert",
      "enabled": true,
      "trigger": {"schedule": {"at": "06:20"}},
      "if": {"command": "今日天氣", "data_gte": ["rain_prob", 70]},
      "then": [{"ntfy": {"title": "帶遮", "message": "{reply}", "priority": 3}}]
    },
    {
      "id": "bin-night",
      "enabled": true,
      "trigger": {"schedule": {"at": "20:00"}},
      "if": {"command": "幾時收垃圾", "data_contains": ["rubbish", "{tomorrow}"]},
      "then": [{"ntfy": {"title": "聽日收垃圾", "message": "今晚記住擺垃圾出去。{reply}", "priority": 4}}]
    },
    {
      "id": "briefing-prewarm",
      "enabled": true,
      "trigger": {"schedule": {"at": "09:55"}},
      "then": [{"command": {"text": "早晨"}}]
    },
    {
      "id": "debate-nzherald-2026-10-14",
      "enabled": true,
      "trigger": {"schedule": {"at": "19:00", "date": "2026-10-14"}},
      "then": [{"ntfy": {"title": "大選辯論開始", "message": "Luxon 對 Hipkins，NZ Herald 領袖辯論而家開始（Three／ThreeNow／Newstalk ZB）。", "priority": 4}}]
    },
    {
      "id": "debate-stuff-2026-10-20",
      "enabled": true,
      "trigger": {"schedule": {"at": "19:30", "date": "2026-10-20"}},
      "then": [{"ntfy": {"title": "大選辯論開始", "message": "Luxon 對 Hipkins，Stuff 領袖辯論而家開始（stuff.co.nz）。", "priority": 4}}]
    },
    {
      "id": "command-error-alert",
      "enabled": true,
      "trigger": {"history": {"status": "error"}},
      "then": [{"ntfy": {"title": "指令出錯", "message": "「{text}」→ {command}：{reply}", "priority": 3}}]
    }
  ]
}
